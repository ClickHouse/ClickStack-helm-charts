# Pinned third-party tool versions for local dev and CI.
# Sourced by shell scripts; included by the Makefile. Override via environment.

HELM_DOCS_VERSION=v1.14.2
HELM_UNITTEST_VERSION=v1.0.3
# helmcov release used by `make coverage` and the GitHub Action.
HELMCOV_VERSION=v0.5.1
# sha256 of that release's checksums.txt; update together with HELMCOV_VERSION.
HELMCOV_CHECKSUMS_SHA256=47357f72d156a7ce30033481d2c65c85e97a716e52e501fbb892c076cc6bc898
# Minimum line-coverage threshold for local `make coverage` and CI helmcov.
COVERAGE_THRESHOLD=28
