# Patterns to ignore when building Helm packages.
# Release notes are generated by scripts/extract-release-notes.js for the
# GitHub release body and must not be packaged into the chart tarball.
RELEASE_NOTES.md
# Common VCS/editor artifacts
.git/
.gitignore
.DS_Store
*.swp
*.bak
*.tmp
*.orig
.vscode/
.idea/
