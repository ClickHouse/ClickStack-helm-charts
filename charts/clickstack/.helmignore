# Patterns to ignore when building Helm packages.
# NOTE: RELEASE_NOTES.md (generated by scripts/extract-release-notes.js) must
# NOT be listed here — chart-releaser reads the release body from inside the
# packaged chart tarball (chart.Files), so it has to be packaged.
# Common VCS/editor artifacts
.git/
.gitignore
.DS_Store
*.swp
*.bak
*.tmp
*.orig
.vscode/
.idea/
